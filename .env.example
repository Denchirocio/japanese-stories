# El historial y las fotos se guardan localmente en el navegador (IndexedDB),
# sin login ni cuentas visibles. Firebase se usa solo como backup automático
# en la nube (auth anónima invisible + Firestore + Storage), para no perder
# el historial si se borra el navegador o se cambia de celular.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# La siguiente variable es server-side, para la función en /api que llama a
# Claude a corregir la escritura. Se configura en el dashboard de Vercel
# (Project Settings > Environment Variables), no acá.
#
# ANTHROPIC_API_KEY=
